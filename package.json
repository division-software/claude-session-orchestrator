{
  "name": "claude-session-orchestrator",
  "version": "0.2.0",
  "description": "MCP server to manage all your Claude Code sessions across machines from one place (Claude app, voice, or another session): tmux + SSH, permission approvals, shared memory, local LLM routing.",
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "mcp",
    "mcp-server",
    "ollama",
    "orchestrator",
    "remote-control",
    "tmux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/division-software/claude-session-orchestrator.git"
  },
  "homepage": "https://github.com/division-software/claude-session-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/division-software/claude-session-orchestrator/issues"
  },
  "bin": {
    "session-orchestrator": "dist/cli.js"
  },
  "files": [
    "dist",
    "hooks",
    "scripts/install-hooks.sh",
    "plugin/skills",
    "config/*.example.yaml"
  ]
}
